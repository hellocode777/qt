# QP Platform — Example Configuration
# Copy this file to config.toml and adjust as needed.

[project]
name = "qp"
version = "0.0.1"
description = "Quant Platform"

[storage]
backend = "duckdb"
duckdb_path = "data/qp.duckdb"
sqlite_path = "data/qp.sqlite"
parquet_dir = "data/parquet"
raw_dir = "data/raw"
dataset_dir = "data/dataset"

[logging]
level = "INFO"
format = "colored"       # "colored" or "json"
json_output = false
log_dir = "logs"
rotation = "10 MB"
retention = "30 days"

[scheduler]
timezone = "Asia/Shanghai"
max_jobs = 100
default_retry_count = 3
default_retry_delay_seconds = 60

[data]
default_start_date = "2015-01-01"
default_source = "akshare"
cache_enabled = true
cache_ttl_hours = 24

[feature]
max_features = 60
correlation_threshold = 0.9

[model]
default_algorithm = "lightgbm"
objective = "lambdarank"
num_leaves = 31
max_depth = 6
learning_rate = 0.05
n_estimators = 1000
min_data_in_leaf = 100
feature_fraction = 0.8
bagging_fraction = 0.8
lambda_l1 = 0.5
lambda_l2 = 0.5
early_stopping_rounds = 50
purged_cv_folds = 5
min_training_window_days = 500

[backtest]
default_slippage_pct = 0.001
commission_pct = 0.00025
stamp_tax_pct = 0.0005
adv_limit_pct = 0.10

[broker]
provider = "simulated"

[monitoring]
psi_threshold = 0.25
max_drawdown_strategy_ratio = 1.5
monthly_drawdown_limit = 0.15
rolling_60d_drawdown_limit = 0.20
consecutive_loss_days = 15
model_decay_ic_ratio = 0.30

[runtime]
env = "development"
