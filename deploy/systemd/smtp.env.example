# SMTP credentials for the QP scheduler — TEMPLATE, no real values.
#
# Install (per machine, once):
#   mkdir -p ~/.config/qp
#   cp deploy/systemd/smtp.env.example ~/.config/qp/smtp.env
#   $EDITOR ~/.config/qp/smtp.env      # fill in real values
#   chmod 600 ~/.config/qp/smtp.env
#
# Consumed by:
#   deploy/systemd/qp-scheduler.service   (EnvironmentFile=-/home/shuai/.config/qp/smtp.env)
#   qp/monitoring/alerts.py               (os.getenv("SMTP_*"))
#
# Why not in the unit file / repo: a plaintext SMTP_PASSWORD lived in
# deploy/systemd/qp-scheduler.service until 2026-10-16 and was committed and
# pushed to origin, so the credential had to be rotated.  Secrets stay outside
# the repository from now on; install-systemd.sh refuses to deploy without this
# file.

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SENDER=you@example.com
SMTP_PASSWORD=
SMTP_RECEIVER=you@example.com
